# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv

# Data and outputs (large files)
input/*
sandbox/*
src/*/output/
src/*/logs/

# Keep directory structure
!input/.gitkeep
!sandbox/.gitkeep

# Logs
*.log

# Model checkpoints / large artifacts (safety net; expected dirs are already ignored)
*.ckpt
*.pt
*.pth
*.safetensors
*.h5

# Jupyter
.ipynb_checkpoints/

# IDE
.idea/
.vscode/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Cache (leaderboard etc.)
.cache/
.ruff_cache/
.pytest_cache/
.mypy_cache/

# Hydra outputs
outputs/
multirun/

# Wandb
wandb/
